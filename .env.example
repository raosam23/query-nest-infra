# Copy this file to ../backend/.env (the path in docker-compose.yml `env_file`).
# From the infra directory: cp .env.example ../backend/.env
#
# The backend service loads every name below. pydantic-settings in
# query-nest-backend reads the same names (app/core/config.py).
# docker-compose.yml also sets DATABASE_URL on the service. That entry
# wins over the value in this file. The URL here is the one the container uses.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/querynest

# Required. Settings has no default.
JWT_SECRET=change-me

# Optional. Settings defaults to HS256 when this is unset.
JWT_ALGORITHM=HS256

# Optional. Settings defaults to 60 when this is unset.
JWT_EXPIRE_MINUTES=60

# Required at import. The chat client and the Tavily tool are built while the app loads.
OPENAI_API_KEY=sk-your-key
TAVILY_API_KEY=tvly-your-key
